# ─────────────────────────────────────────────────────────────
# puffdns 环境变量
# 复制为 .env 后按需修改；docker compose 会自动读取同目录的 .env
# ─────────────────────────────────────────────────────────────

# ── DNS 监听 ────────────────────────────────────────────────
DNS_PORT=53

# ── Web 面板与 DoH ──────────────────────────────────────────
WEB_PORT=8080
# 只在本机监听可避免面板暴露到公网；需要 DoH 对外时改成 0.0.0.0
WEB_HOST=0.0.0.0
DOH_ENABLED=true

# ── 上游转发 ────────────────────────────────────────────────
# 逗号分隔，可显式指定协议：udp://1.1.1.1:53、tcp://8.8.8.8:53
UPSTREAMS=1.1.1.1,8.8.8.8,9.9.9.9
UPSTREAM_TIMEOUT=3000

# ── 缓存 ────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=20000
CACHE_MIN_TTL=0
CACHE_MAX_TTL=86400
# 上游全部不可用时，是否继续返回已过期的缓存结果
SERVE_STALE=true

# ── 解析行为 ────────────────────────────────────────────────
# false：优先答本地域名，其余转发上游（推荐）
# true ：不回答本地域名，全部转发（纯递归模式）
FORWARD_ONLY=false
# 为 NS / MX 记录自动补充 A 记录 glue
ADD_GLUE=true
# 新建记录与区域的默认 TTL（秒）
DEFAULT_TTL=300

# ── 查询日志 ────────────────────────────────────────────────
QUERY_LOG=true
QUERY_LOG_SIZE=1000

# ── 日志 ────────────────────────────────────────────────────
# error | warn | info | debug | trace
LOG_LEVEL=info
# 留空则输出到 stdout（docker logs 可见）
LOG_FILE=

# ── 初始管理员 ──────────────────────────────────────────────
# 仅在数据库为空、首次启动时生效。
# 留空则自动生成随机密码并打印到容器日志（只出现一次，务必保存）。
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── 时区 ────────────────────────────────────────────────────
TZ=Asia/Shanghai
